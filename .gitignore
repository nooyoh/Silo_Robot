# 로컬/Orin 모델 파일 (어디에 두든 전부 제외)
*.pt
*.onnx
*.engine

# Jetson 배포용 아티팩트·런타임 로그
YOLOv8s/inference/artifacts/
YOLOv8s/inference/logs/
*.jsonl

# 로컬 테스트 산출물
YOLOv8s/local_test/_webcam_shots/
YOLOv8s/local_test/_smoke/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/

