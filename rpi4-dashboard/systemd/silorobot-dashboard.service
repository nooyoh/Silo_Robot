[Unit]
Description=SiloRobot RPi4 operator dashboard
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/rpi4-dashboard
ExecStart=%h/rpi4-dashboard/run.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
